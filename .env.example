# Public Supabase values (Project Settings -> API / Connect)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only values. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
RATE_LIMIT_HMAC_SECRET=

# Cloudinary configuration (server-only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Brevo transactional email configuration (server-only)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=MinBack

APP_URL=http://localhost:3000

# Performance rollout flags
MINBACK_SHARED_NOTIFICATION_POLLING_V2=false
MINBACK_CLASS_DASHBOARD_RPC_V2=false
PERFORMANCE_TELEMETRY_SAMPLE_RATE=0.05
# Optional fallback URL used by perf:slo when the two 15-minute windows lack samples.
SYNTHETIC_MONITOR_URL=

